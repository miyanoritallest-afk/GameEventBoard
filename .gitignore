# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（実際の値を含む .env は除外。値のないテンプレートはコミットする）
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright 実機確認の生成物（スクショ・アクセシビリティスナップショット）
/.playwright-mcp/
/*.png
/*.yml

# Supabase CLI の一時ファイル
supabase/.temp/

# 開発・確認専用のダミー投入SQL（auth.users へ直接 INSERT するため本番に流さない）
supabase/dev_seed_*.sql

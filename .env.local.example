# Supabase 接続情報（Supabaseダッシュボード > Project Settings > API から取得）
# このファイルを .env.local にコピーして値を埋める。.env.local は git 管理外（.gitignore済み）。

# プロジェクトURL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# 公開可能な anon キー（ブラウザに露出してよい。RLSで保護する前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サービスロールキー（サーバー専用・絶対にクライアントに出さない。RLSを無視する強力な鍵）
# 管理用バッチや signed 操作でのみ使用。通常のアプリ処理では使わない。
SUPABASE_SERVICE_ROLE_KEY=

# Discord Bot トークン（サーバー専用・絶対にクライアントに出さない）。
# 個人宛 DM 通知（#7 試合直前 / #8 スクリム直前リマインド）の送信に使う。
# Discord Developer Portal でアプリ→Bot を作成し、対象サーバーに招待して取得する。
# 未設定でもビルド・他処理は通る（DM は skipped として記録され送られないだけ）。
DISCORD_BOT_TOKEN=

# アプリの公開 URL（例: https://your-app.vercel.app）。末尾スラッシュなし。
# 通知メッセージ内のリンクを絶対 URL にするために使う（Discord からは絶対 URL でないと踏めない）。
# ローカル開発では未設定でよい（http://localhost:3000 にフォールバックする）。本番では必ず設定する。
NEXT_PUBLIC_APP_URL=

# Cron エンドポイント（スケジュール通知）の保護用シークレット（サーバー専用）。
# /api/cron/notifications は `Authorization: Bearer <CRON_SECRET>` を検証し、一致しないリクエストは拒否する。
# Vercel Cron を使う場合は Vercel 側の Cron 設定とこの値を揃える。任意の十分に長いランダム文字列を設定する。
CRON_SECRET=
